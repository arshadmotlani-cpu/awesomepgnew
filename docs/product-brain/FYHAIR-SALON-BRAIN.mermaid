flowchart TB
  subgraph SalonSoftwareSaaS["Target SaaS hierarchy (Salon Software)"]
    FYT["For Your Technologies"]
    SS["Salon Software"]
    FYT --> SS
    subgraph Tenants["Organizations / Salons"]
      direction LR
      FYH["FYHAIR — Reference Salon / Current Implementation"]
      SB["Salon B — Future Tenant"]
      SC["Salon C — Future Tenant"]
    end
    SS --> Tenants
  end


