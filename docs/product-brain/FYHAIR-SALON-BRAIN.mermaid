flowchart TB
  subgraph CoreProductSpine["Salon Software — core workflow (product workshop)"]
    direction TB
    S1[Salon / location context]
    S2[Customer]
    S3[Appointment or walk-in]
    S4[Service / product]
    S5[Staff]
    S6[Basket]
    S7[Pricing / tax / discount]
    S8[Payment]
    S9[Invoice]
    S10[Business records]
    S1 --> S2 --> S3 --> S4 --> S5 --> S6 --> S7 --> S8 --> S9 --> S10
  end

