{
  "name": "awesomepg",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx src/db/startupMigrationGate.ts && next dev",
    "env:pull": "npx vercel env pull .env.local --environment=preview",
    "env:check": "tsx scripts/check-env.ts",
    "db:status": "tsx src/db/migrationStatus.ts",
    "build": "next build",
    "vercel-build": "bash scripts/vercel-build.sh",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts",
    "db:studio": "drizzle-kit studio",
    "neon:cleanup-branches": "tsx scripts/cleanup-neon-preview-branches.ts",
    "neon:cleanup-branches:execute": "tsx scripts/cleanup-neon-preview-branches.ts --execute",
    "test": "npx tsx scripts/lint-image-uploads.ts && npx tsx scripts/lint-private-blob-display.ts && node scripts/run-unit-tests.mjs",
    "test:ci": "npx tsx scripts/lint-image-uploads.ts && npx tsx scripts/lint-private-blob-display.ts && TEST_CONCURRENCY=1 node scripts/run-unit-tests.mjs",
    "test:hair": "npm run hair:db:migrate && node scripts/run-unit-tests.mjs hair",
    "test:pg": "node scripts/run-unit-tests.mjs pg",
    "test:capital": "node scripts/run-unit-tests.mjs capital",
    "test:owner": "node scripts/run-unit-tests.mjs owner",
    "test:billing-settlement": "npx tsx --test tests/unit/billingEngineValidation.test.ts tests/unit/moveOutSettlementExplanation.test.ts tests/unit/settlementRuleRegistry.test.ts tests/unit/billingCoverageRegression.test.ts",
    "stability:report": "npx tsx scripts/regression-report.ts",
    "stability:report:ci": "npx tsx scripts/regression-report.ts --ci",
    "cert:shantinagar-phase1": "npx tsx scripts/run-shantinagar-phase1-portal-certification.ts",
    "cert:shantinagar-phase1:json": "npx tsx scripts/run-shantinagar-phase1-portal-certification.ts --json",
    "cert:room-os-wave2": "npx tsx scripts/run-room-os-wave2-certification.ts",
    "cert:room-os-wave2:json": "npx tsx scripts/run-room-os-wave2-certification.ts --json",
    "cert:room-os-wave3": "npx tsx scripts/run-room-os-wave2-certification.ts",
    "cert:room-os-wave3:json": "npx tsx scripts/run-room-os-wave2-certification.ts --json",
    "cert:room-os-wave4": "npx tsx scripts/run-room-os-wave4-certification.ts",
    "cert:room-os-wave4:json": "npx tsx scripts/run-room-os-wave4-certification.ts --json",
    "cert:room-os-wave5": "npx tsx scripts/run-room-os-wave5-certification.ts",
    "cert:room-os-wave5:json": "npx tsx scripts/run-room-os-wave5-certification.ts --json",
    "cert:room-os-wave6": "npx tsx scripts/run-room-os-wave6-certification.ts",
    "cert:room-os-wave6:json": "npx tsx scripts/run-room-os-wave6-certification.ts --json",
    "bench:room-os-wave2": "npx tsx scripts/benchmark-room-os-wave2.ts",
    "profile:admin": "tsx scripts/profile-admin-full.ts",
    "lint:uploads": "tsx scripts/lint-image-uploads.ts",
    "lint:private-blobs": "tsx scripts/lint-private-blob-display.ts",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test tests/e2e/smoke.spec.ts",
    "test:e2e:hair": "playwright test --project=hair-setup --project=hair",
    "prepare": "bash scripts/install-git-hooks.sh",
    "docs:sync": "tsx scripts/sync-docs-pre-commit.ts",
    "docs:check": "tsx scripts/sync-docs-pre-commit.ts --check",
    "docs:links": "tsx scripts/verify-docs-links.ts",
    "capital:db:generate": "drizzle-kit generate --config capital/drizzle.config.ts",
    "capital:db:migrate": "tsx src/capital/db/migrate.ts",
    "capital:db:seed": "tsx src/capital/db/seed.ts",
    "capital:db:studio": "drizzle-kit studio --config capital/drizzle.config.ts",
    "owner:db:generate": "drizzle-kit generate --config owner/drizzle.config.ts",
    "owner:db:migrate": "tsx src/owner/db/migrate.ts",
    "owner:db:seed": "tsx src/owner/db/seed.ts",
    "admin:standardize": "tsx scripts/standardize-ecosystem-admin.ts",
    "admin:verify-login": "tsx scripts/verify-ecosystem-admin-login.ts",
    "owner:db:studio": "drizzle-kit studio --config owner/drizzle.config.ts",
    "hair:db:generate": "drizzle-kit generate --config hair/drizzle.config.ts",
    "hair:db:migrate": "tsx src/hair/db/migrate.ts",
    "hair:db:seed": "tsx src/hair/db/seed.ts",
    "hair:db:studio": "drizzle-kit studio --config hair/drizzle.config.ts",
    "hair:db:introspect": "tsx scripts/hair-db-introspection-readonly.ts",
    "hair:import:historical": "tsx scripts/hair-import-historical.ts",
    "hair:import:template": "tsx scripts/generate-historical-import-template.ts",
    "platform:db:generate": "drizzle-kit generate --config platform/drizzle.config.ts",
    "platform:db:migrate": "tsx src/platform/db/migrate.ts",
    "platform:db:studio": "drizzle-kit studio --config platform/drizzle.config.ts",
    "hair:saas:bootstrap-platform": "tsx scripts/hair-saas-bootstrap-platform.ts",
    "hair:saas:backfill-tenant": "tsx scripts/hair-saas-backfill-tenant.ts",
    "hair:saas:bootstrap-verify": "tsx scripts/hair-saas-bootstrap-verify.ts",
    "hair:saas:tenant-reconcile": "tsx scripts/hair-saas-tenant-reconcile-readonly.ts",
    "hair:saas:apply-not-null": "tsx scripts/hair-saas-apply-not-null.ts",
    "hair:saas:staging-smoke": "tsx scripts/hair-saas-staging-smoke.ts",
    "staging:verify-vercel-env": "tsx scripts/staging-verify-vercel-env.ts",
    "staging:safety-gate": "tsx scripts/staging-safety-gate.ts",
    "production:safety-gate": "tsx scripts/production-safety-gate.ts",
    "production:preflight": "tsx scripts/production-safety-gate.ts && tsx scripts/hair-saas-production-preflight-readonly.ts",
    "hair:saas:production-preflight": "tsx scripts/hair-saas-production-preflight-readonly.ts",
    "hair:saas:production-phase3": "tsx scripts/production-safety-gate.ts && tsx scripts/hair-saas-bootstrap-platform.ts && tsx scripts/hair-saas-backfill-tenant.ts && tsx scripts/hair-saas-bootstrap-verify.ts && tsx scripts/hair-saas-tenant-reconcile-readonly.ts",
    "staging:preflight": "tsx scripts/staging-safety-gate.ts && tsx scripts/hair-saas-staging-preflight.ts",
    "staging:phase0b": "tsx scripts/staging-phase0b-run.ts",
    "platform:stripe:webhook-verify-staging": "tsx scripts/platform-stripe-webhook-verify-staging.ts",
    "saas:phase-e-f:staging-smoke": "tsx scripts/saas-phase-e-f-staging-smoke.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toast": "^1.2.19",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@sentry/nextjs": "^10.57.0",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.4.0",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.40.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.24.0",
    "next": "16.2.6",
    "nodemailer": "^8.0.10",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "posthog-js": "^1.386.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "recharts": "^3.9.2",
    "sharp": "^0.34.5",
    "stripe": "^22.5.0",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.49.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
}
